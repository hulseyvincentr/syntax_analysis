+def plot_group_comparison_timecourse(
+    summaries: dict[str, pd.DataFrame],
+    out_base: Path,
+    *,
+    metric_col: str,
+    y_label: str,
+    reference_value: float,
+    x_min: int,
+    x_max: int,
+    band: str,
+    min_animals_for_summary: int,
+    dpi: int,
+    show: bool,
+) -> None:
+    """Plot equal-bird rolling summaries for pooled M+L and sham on one axis."""
+    fig, ax = plt.subplots(figsize=(8.4, 4.8))
+    plotted_groups: list[str] = []
+    all_values: list[np.ndarray] = []
+    band_label = "IQR across birds"
+
+    for group in [POOLED_ML_GROUP, SHAM_GROUP]:
+        summary = summaries.get(group)
+        if summary is None or summary.empty:
+            continue
+
+        s = summary.sort_values("relative_day")
+        color = GROUP_LINE_COLORS[group]
+        if (
+            band == "bootstrap_ci"
+            and s[["bootstrap_ci_low", "bootstrap_ci_high"]].notna().any().all()
+        ):
+            lower = s["bootstrap_ci_low"].to_numpy(dtype=float)
+            upper = s["bootstrap_ci_high"].to_numpy(dtype=float)
+            band_label = "95% bootstrap CI"
+        else:
+            lower = s["q25"].to_numpy(dtype=float)
+            upper = s["q75"].to_numpy(dtype=float)
+            band_label = "IQR across birds"
+
+        x = s["relative_day"].to_numpy(dtype=float)
+        ax.fill_between(
+            x,
+            lower,
+            upper,
+            color=color,
+            alpha=0.16,
+            linewidth=0,
+            zorder=2,
+        )
+        ax.plot(
+            x,
+            s["summary"],
+            color=color,
+            linewidth=3.2,
+            zorder=3,
+        )
+        plotted_groups.append(group)
+        all_values.extend(
+            [
+                pd.to_numeric(s[column], errors="coerce").dropna().to_numpy(dtype=float)
+                for column in ["summary", "q25", "q75"]
+                if column in s.columns
+            ]
+        )
+
+    if not plotted_groups:
+        plt.close(fig)
+        warnings.warn("No M+L or sham rolling summaries were available for comparison.")
+        return
+
+    ax.axhline(reference_value, color="0.35", linestyle=":", linewidth=1.1, zorder=0)
+    ax.axvline(0, color=LESION_COLOR, linestyle="--", linewidth=1.3, zorder=4)
+    ax.set_xlim(x_min, x_max)
+    ax.set_xlabel("Days relative to lesion", fontsize=17)
+    ax.set_ylabel(y_label, fontsize=17)
+    pretty_axes(ax, tick_fontsize=12.5)
+
+    values = np.concatenate([v for v in all_values if v.size]) if any(v.size for v in all_values) else np.array([])
+    positive = values[np.isfinite(values) & (values > 0)]
+    if positive.size:
+        lo = min(float(np.nanmin(positive)), reference_value)
+        hi = max(float(np.nanmax(positive)), reference_value)
+        if hi > lo > 0:
+            # Match the existing fold-change Panel E convention.
+            ax.set_yscale("log")
+            ax.set_ylim(lo * 0.97, hi * 1.06)
+            apply_plain_log_tick_labels(ax, axis="y")
+
+    handles: list[object] = []
+    for group in plotted_groups:
+        handles.append(
+            Line2D(
+                [0],
+                [0],
+                color=GROUP_LINE_COLORS[group],
+                linewidth=3.2,
+                label=(
+                    f"{GROUP_DISPLAY_LABELS[group]} rolling median "
+                    f"(n≥{min_animals_for_summary})"
+                ),
+            )
+        )
+    handles.extend(
+        [
+            Patch(facecolor="0.45", edgecolor="none", alpha=0.16, label=band_label),
+            Line2D(
+                [0],
+                [0],
+                color=LESION_COLOR,
+                linestyle="--",
+                linewidth=1.3,
+                label="lesion/injection day",
+            ),
+        ]
+    )
+    ax.legend(handles=handles, frameon=False, fontsize=9.5, loc="upper left")
+    fig.tight_layout()
+    fig.subplots_adjust(left=0.25, bottom=0.16)
+    save_figure(fig, out_base, dpi=dpi, show=show)
+
