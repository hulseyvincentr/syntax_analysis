+def run_ml_vs_sham_cv_comparison(
+    daily: pd.DataFrame,
+    *,
+    out_dir: Path,
+    baseline_start_day: int,
+    baseline_end_day: int,
+    min_baseline_days: int,
+    x_min: int,
+    x_max: int,
+    smooth_window_days: int,
+    rolling_stat: str,
+    min_observations_per_bird_window: int,
+    min_animals_for_summary: int,
+    bootstrap_reps: int,
+    seed: int,
+    band: str,
+    dpi: int,
+    show: bool,
+) -> dict[str, Path]:
+    """Create the additional baseline-normalized CV panel for M+L versus sham."""
+    outputs: dict[str, Path] = {}
+    normalized_parts: list[pd.DataFrame] = []
+    baseline_parts: list[pd.DataFrame] = []
+    summary_parts: list[pd.DataFrame] = []
+    summaries: dict[str, pd.DataFrame] = {}
+
+    group_masks = {
+        POOLED_ML_GROUP: daily["display_group"].isin(ML_GROUPS),
+        SHAM_GROUP: daily["display_group"].eq(SHAM_GROUP),
+    }
+
+    for group_index, group in enumerate([POOLED_ML_GROUP, SHAM_GROUP]):
+        subset = daily.loc[group_masks[group]].copy()
+        if subset.empty:
+            warnings.warn(
+                f"Skipping {GROUP_DISPLAY_LABELS[group]} in the comparison panel: no CV rows."
+            )
+            continue
+        subset["display_group"] = group
+
+        normalized, baseline = add_baseline_normalization(
+            subset,
+            value_col="cv",
+            baseline_start_day=baseline_start_day,
+            baseline_end_day=baseline_end_day,
+            min_baseline_days=min_baseline_days,
+        )
+        normalized["display_group"] = group
+        baseline["display_group"] = group
+
+        summary = equal_bird_rolling_summary(
+            normalized,
+            metric_col="fold_change",
+            x_min=x_min,
+            x_max=x_max,
+            window_days=smooth_window_days,
+            rolling_stat=rolling_stat,
+            min_observations_per_bird_window=min_observations_per_bird_window,
+            min_animals_for_summary=min_animals_for_summary,
+            bootstrap_reps=bootstrap_reps,
+            seed=seed + 20000 + group_index * 1000,
+        )
+        summary["display_group"] = group
+
+        normalized_parts.append(normalized)
+        baseline_parts.append(baseline)
+        summary_parts.append(summary)
+        summaries[group] = summary
+
+    if not summaries:
+        warnings.warn("The M+L versus sham CV comparison panel was not generated.")
+        return outputs
+
+    normalized_all = pd.concat(normalized_parts, ignore_index=True)
+    baseline_all = pd.concat(baseline_parts, ignore_index=True)
+    summary_all = pd.concat(summary_parts, ignore_index=True)
+
+    normalized_path = out_dir / "panelE_ML_vs_sham_daily_CV_normalized.csv"
+    baseline_path = out_dir / "panelE_ML_vs_sham_CV_baseline_summary.csv"
+    summary_path = out_dir / "panelE_ML_vs_sham_CV_fold_change_equal_weight_rolling_summary.csv"
+    outputs["CV_ML_vs_sham_normalized_table"] = write_csv(normalized_all, normalized_path)
+    outputs["CV_ML_vs_sham_baseline_table"] = write_csv(baseline_all, baseline_path)
+    outputs["CV_ML_vs_sham_fold_change_summary"] = write_csv(summary_all, summary_path)
+
+    out_base = out_dir / "panelE_ML_vs_sham_CV_fold_change_timecourse_summary_only"
+    plot_group_comparison_timecourse(
+        summaries,
+        out_base,
+        metric_col="fold_change",
+        y_label="Phrase duration CV\n/ late-pre baseline",
+        reference_value=1.0,
+        x_min=x_min,
+        x_max=x_max,
+        band=band,
+        min_animals_for_summary=min_animals_for_summary,
+        dpi=dpi,
+        show=show,
+    )
+    outputs["CV_ML_vs_sham_fold_change_timecourse_png"] = out_base.with_suffix(".png")
+    outputs["CV_ML_vs_sham_fold_change_timecourse_pdf"] = out_base.with_suffix(".pdf")
+    return outputs
+
